# Copy to .env and fill in. Never commit .env.
# There is no login yet: keep this on localhost.
VELOPIM_ADDR=127.0.0.1:8080
# Name recorded with every decision made in the web interface.
VELOPIM_ACTOR=betreiber
# Original supplier files are kept under <dir>/raw.
VELOPIM_DATA_DIR=data

POSTGRES_PASSWORD=
DATABASE_URL=postgres://velopim:CHANGEME@127.0.0.1:5432/velopim?sslmode=disable

# Shopify: development store only. Writes stay disabled (dry run) unless explicitly enabled.
# Create an app in the Shopify Dev Dashboard, install it on the dev store and copy
# Client ID and Client secret from the app's settings (see docs/shopify-dev-store.md).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WRITE_ENABLED=false
# Optional: send pending changes to Shopify at this interval while the server runs
# (needs SHOPIFY_WRITE_ENABLED=true). Empty: only on request.
VELOPIM_SYNC_INTERVAL=

# Secrets for collecting supplier files. The settings of a supplier only name
# the variable; its name must start with VELOPIM_FETCH_.
# VELOPIM_FETCH_HARTJE_USER=
# VELOPIM_FETCH_HARTJE_PASSWORD=

# Daily mail about open tasks. Without VELOPIM_SMTP_HOST no mail is sent.
# Port 587 uses STARTTLS, port 465 TLS from the start. Try it with: velopim digest
VELOPIM_SMTP_HOST=
VELOPIM_SMTP_PORT=587
VELOPIM_SMTP_USER=
VELOPIM_SMTP_PASSWORD=
VELOPIM_MAIL_FROM=
# One or more recipients, separated by commas.
VELOPIM_MAIL_TO=
# When the mail is sent (local time) and where velopim is reachable, for the link.
VELOPIM_MAIL_TIME=07:00
VELOPIM_BASE_URL=http://localhost:8080

# Description drafts for products (docs/decisions/0032). Without a key the
# feature is off.
ANTHROPIC_API_KEY=
# VELOPIM_AI_MODEL=claude-opus-5-5
