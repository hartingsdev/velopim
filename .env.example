# Copy to .env and fill in. Never commit .env.
# There is no login yet: keep this on localhost.
VELOPIM_ADDR=127.0.0.1:8080
# Name recorded with every decision made in the web interface.
VELOPIM_ACTOR=betreiber
# Original supplier files are kept under <dir>/raw.
VELOPIM_DATA_DIR=data

POSTGRES_PASSWORD=
DATABASE_URL=postgres://velopim:CHANGEME@127.0.0.1:5432/velopim?sslmode=disable

# Shopify: development store only. Writes stay disabled (dry run) unless explicitly enabled.
# Create an app in the Shopify Dev Dashboard, install it on the dev store and copy
# Client ID and Client secret from the app's settings (see docs/shopify-dev-store.md).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WRITE_ENABLED=false
